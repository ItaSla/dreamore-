          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["Visitante", "Desenvolvedor", "Administrador"],
          "maxLength": 32
        },
        "bio": {
          "type": "string",
          "maxLength": 600
        },
        "location": {
          "type": "string",
          "maxLength": 100
        },
        "site": {
          "type": "string",
          "maxLength": 300
        },
        "photo": {
          "type": "string",
          "maxLength": 260000
        },
        "banner": {
          "type": "string",
          "maxLength": 300000
        },
        "socials": {
          "type": "object"
        },
        "resume": {
          "type": "string",
          "maxLength": 2000
        },
        "skills": {
          "type": "array"
        },
        "followers": {
          "type": "array"
        },
        "online": {
          "type": "boolean"
        },
        "visibility": {
          "type": "string",
          "enum": ["public"],
          "maxLength": 16
        },
        "lastSeen": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "name", "role", "visibility", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Indie game project listed in the DREAMORE+ lobby and showcase.",
      "type": "object",
      "properties": {
        "id": {
