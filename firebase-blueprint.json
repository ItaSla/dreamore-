  "firestore": {
    "/test/connection": {
      "schema": { "$ref": "#/entities/ConnectionTest" },
      "description": "Server connection probe document for validating live Firestore setup."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authoritative admin UID registry."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Owner-only private user account data containing email PII."
    },
    "/users_public/{uid}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public developer profile with avatar photo, banner, socials, and follower count."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Indie game projects created and updated by developers."
    },
    "/projects/{projectId}/applications/{appId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Team recruitment applications scoped to a parent project."
    },
    "/feed_posts/{postId}": {
      "schema": { "$ref": "#/entities/FeedPost" },
      "description": "Community feed updates and milestone posts."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Community and studio chat groups with photo, description, members, and moderators."
    },
    "/groups/{groupId}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/GroupMessage" },
      "description": "Messages inside a group gated by parent group membership."
    },
    "/channels/{channelId}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/ChannelMessage" },
      "description": "Messages inside public community chat channels."
    }
  }
}
