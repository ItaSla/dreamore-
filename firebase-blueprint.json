{
  "entities": {
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Read-only health check document for verifying live Firestore connectivity.",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "Whether the connection endpoint is active."
        }
      },
      "required": ["ok"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authoritative admin membership record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Owner-isolated PII and account metadata for an authenticated DREAMORE+ user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["Visitante", "Desenvolvedor", "Administrador"],
          "maxLength": 32
        },
        "provider": {
          "type": "string",
          "enum": ["google", "local"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "username", "name", "role", "provider", "createdAt", "updatedAt"]
    },
    "UserPublic": {
      "title": "UserPublic",
